# Contact Form Configuration
# Retrieve a free access key from: https://web3forms.com/
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Telegram Notification Configuration (Optional)
# 1. Message @BotFather on Telegram and send /newbot to create a bot. Copy the API Token.
VITE_TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# 2. Message @userinfobot on Telegram to retrieve your personal numerical Chat ID.
VITE_TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Instant Mobile/Desktop Push Notifications (via ntfy.sh - 100% Free, No credentials needed)
# Change 'mubashir_portfolio_contact' to a secret word for privacy
VITE_NTFY_TOPIC=mubashir_portfolio_contact

